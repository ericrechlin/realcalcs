# Keyboard US: Keyboard-Emulation for PC and HP-19

Scancode 8			# <-
	ResetFlag 0
	Map 8 35
End

Scancode 9			# TAB
	IfPressed 16
		IfFlag 0
			Release 21
			ResetFlag 0
